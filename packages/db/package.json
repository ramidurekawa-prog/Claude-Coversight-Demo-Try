{
  "name": "@streamline/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLite (better-sqlite3 + drizzle) schema, migrations, org-scoped repositories and the seed.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "reset": "tsx src/scripts/reset.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@streamline/engine": "workspace:*",
    "@streamline/fixture": "workspace:*",
    "better-sqlite3": "^12.4.0",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
