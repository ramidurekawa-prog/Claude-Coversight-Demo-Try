{
  "name": "@streamline/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres-dialect Drizzle schema, migrations, org-scoped repositories, rollups, lifecycle, seed. PGlite (in-process Postgres) by default; DATABASE_URL for a real server.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-helpers": "./src/test-helpers.ts",
    "./connect": "./src/connect.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "reset": "tsx src/scripts/reset.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "@streamline/engine": "workspace:*",
    "@streamline/fixture": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
