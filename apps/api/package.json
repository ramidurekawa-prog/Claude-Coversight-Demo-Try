{
  "name": "@streamline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API: auth (better-auth), org-scoped routes, the demo clock and the nightly job.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "STREAMLINE_FAST_HASH=1 STREAMLINE_RESET_ON_START=1 STREAMLINE_PGLITE_DIR=../../packages/db/data/pglite-e2e tsx src/server.ts",
    "demo": "tsx src/server.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.18",
    "@streamline/contracts": "workspace:*",
    "@streamline/db": "workspace:*",
    "@streamline/engine": "workspace:*",
    "@streamline/fixture": "workspace:*",
    "better-auth": "^1.6.18",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  },
  "main": "./src/app.ts",
  "types": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./app": "./src/app.ts",
    "./test-helpers": "./src/test-helpers.ts"
  }
}
