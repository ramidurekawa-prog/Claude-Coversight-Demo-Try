# Copy to .env (optional). Defaults work for the demo with zero external services.

# Leave DATABASE_URL unset to use the in-process PGlite database (packages/db/data/pglite).
# Set it to use a real Postgres, e.g. after `docker compose up -d postgres`:
# DATABASE_URL=postgres://streamline:streamline@localhost:5432/streamline
DATABASE_URL=

# Auth (apps/api). Any long random string; an insecure dev default applies when unset.
BETTER_AUTH_SECRET=
# Public origins.
API_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
NEXT_TELEMETRY_DISABLED=1
