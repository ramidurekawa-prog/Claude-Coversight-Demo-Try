{
  "name": "streamline-coversight-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Streamline by Coversight \u2014 closed-loop margin controller for restaurant groups (sales demo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @streamline/api dev\" \"pnpm --filter @streamline/web dev\"",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @streamline/api build && pnpm --filter @streamline/web build",
    "start": "concurrently -n api,web -c blue,green \"pnpm --filter @streamline/api start\" \"pnpm --filter @streamline/web start\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @streamline/web build && playwright test",
    "db:reset": "pnpm --filter @streamline/db reset",
    "db:seed": "pnpm --filter @streamline/db seed",
    "db:seed:deploy": "pnpm --filter @streamline/db seed:deploy",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev:api": "pnpm --filter @streamline/api dev",
    "dev:web": "pnpm --filter @streamline/web dev",
    "e2e:ui": "playwright test --ui",
    "demo": "pnpm --filter @streamline/web build && concurrently -n api,web -c blue,green \"pnpm --filter @streamline/api demo\" \"pnpm --filter @streamline/web start\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.0",
    "concurrently": "^9.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  },
  "type": "module"
}
