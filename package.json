{
  "name": "streamline-coversight-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Streamline by Coversight — closed-loop margin controller for restaurant groups (sales demo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @streamline/web dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @streamline/web build",
    "start": "pnpm --filter @streamline/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:reset": "pnpm --filter @streamline/db reset",
    "db:seed": "pnpm --filter @streamline/db seed",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  },
  "type": "module"
}
